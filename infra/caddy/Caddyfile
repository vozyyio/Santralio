# Santralio: HTTPS ters vekil. Şablondur: infra/web-deploy.sh, /etc/santralio/site.env değerleriyle doldurup
# /etc/caddy/Caddyfile olarak kurar (@SANTRALIO_…@ yer tutucuları, bkz. infra/lib/site.sh).
#
# Panel adresleri Cloudflare proxy'si (turuncu bulut) arkasındaysa (SANTRALIO_CLOUDFLARE=yes):
# - Yalnızca Cloudflare'den gelen bağlantılar kabul edilir; böylece CF-Connecting-IP başlığına güvenilir
#   ve API'nin giriş sınırı gerçek istemci IP'siyle çalışır.
# - Cloudflare IP listesi: infra/caddy/cloudflare-ips.txt (https://www.cloudflare.com/ips).
#
# SIP adresi proxy'sizdir; Caddy yalnızca certbot'un webroot doğrulama dosyalarını sunar.
# Asterisk'in TLS sertifikası certbot ile alınır ve yenilenir (infra/asterisk/cert-hook.sh).

(cloudflare) {
	@not_cloudflare @SANTRALIO_CADDY_NOT_ALLOWED@
}

# Üç adres aynı paneli ve aynı API'yi sunar; panel hangi ekranı açacağını adresten anlar:
#   panel  : ayarlar ve personel (patron, müdür)
#   crm    : görüşmeler, kayıtlar, raporlar, günlükler, müşteriler
#   agent  : temsilci masası (tarayıcıdan arama; /ws yalnızca burada)
(santralio_app) {
	import cloudflare
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=()"
		-Server
	}

	# route içindekiler yazıldığı sırayla çalışır: önce Cloudflare dışı bağlantı reddedilir.
	route {
		respond @not_cloudflare "Yalnızca @SANTRALIO_BASE_DOMAIN@ adresleri üzerinden erişilebilir." 403

		handle /api/* {
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Forwarded-For @SANTRALIO_CADDY_CLIENT_IP@
			}
		}

		handle {
			root * /opt/santralio/web
			try_files {path} /index.html
			file_server
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
		}
	}
}

(csp) {
	header Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' {args[0]}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
}

panel.@SANTRALIO_BASE_DOMAIN@ {
	import csp ""
	import santralio_app
}

crm.@SANTRALIO_BASE_DOMAIN@ {
	import csp ""
	import santralio_app
}

agent.@SANTRALIO_BASE_DOMAIN@ {
	import csp wss://agent.@SANTRALIO_BASE_DOMAIN@
	# Temsilci masası: SIP-over-WebSocket. Önce oturum (çerez) API'de doğrulanır,
	# yalnızca temsilci masası yetkisi ve dahilisi olan kullanıcı Asterisk'e (yalnızca localhost) bağlanır.
	# route, snippet'teki route'tan önce çalışsın diye ayrı bir route bloğundadır.
	route /ws {
		respond @not_cloudflare 403
		forward_auth 127.0.0.1:8090 {
			uri /api/auth/ws
		}
		reverse_proxy 127.0.0.1:8088
	}
	import santralio_app
}

# Tanıtım sitesi, kayıt (/basvuru) ve ödeme (/odeme) sayfaları: statik, /opt/santralio/site.
# Bu blok yokken Cloudflare origin'e bu adla bağlanınca sertifika bulamıyor, TLS kesiliyordu (525).
# Referrer-Policy no-referrer: /odeme?token=… adresi başka sitelere sızmasın. Caddy erişim günlüğü tutmaz (log yok);
# token sunucuda kaydedilmez.
@SANTRALIO_BASE_DOMAIN@, www.@SANTRALIO_BASE_DOMAIN@ {
	import cloudflare
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Bakım modu: /opt/santralio/maintenance.on varsa ana sayfa, /basvuru ve /odeme yerine bakım sayfası
	# (bakim.html) 503 ile sunulur. Panel, API ve santral etkilenmez. Aç/kapat: sudo infra/maintenance.sh true | false
	# Dosya her istekte kontrol edilir; Caddy'yi yeniden yüklemek gerekmez. /assets/* (CSS) bakımda da sunulur.
	@maintenance {
		file {
			root /opt/santralio
			try_files maintenance.on
		}
		not path /assets/*
	}

	route {
		respond @not_cloudflare "Yalnızca @SANTRALIO_BASE_DOMAIN@ adresleri üzerinden erişilebilir." 403
		handle @maintenance {
			header Retry-After "3600"
			header Cache-Control "no-store"
			root * /opt/santralio/site
			rewrite * /bakim.html
			file_server {
				status 503
			}
		}
		root * /opt/santralio/site
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Hata yanıtlarında Caddy önceki başlıkları siler; no-referrer burada da gönderilir.
	handle_errors {
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		respond "{err.status_code} {err.status_text}"
	}
}

# Dış servislerin çağırdığı API: Vozyy lisans olayları, ödeme sağlayıcısı bildirimleri ve test ödeme sayfası. Gerisi 404.
api.@SANTRALIO_BASE_DOMAIN@ {
	import cloudflare

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	route {
		respond @not_cloudflare "Yalnızca @SANTRALIO_BASE_DOMAIN@ adresleri üzerinden erişilebilir." 403
		@vozyy_events {
			method POST
			path /api/vozyy/events
		}
		handle @vozyy_events {
			request_body {
				max_size 64KB
			}
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Forwarded-For @SANTRALIO_CADDY_CLIENT_IP@
			}
		}
		# Ödeme sağlayıcılarının sunucudan bildirimi (imza uygulamada doğrulanır).
		@payment_callback {
			method POST
			path_regexp ^/api/payments/callback/[a-z0-9]{32}$
		}
		handle @payment_callback {
			request_body {
				max_size 64KB
			}
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Forwarded-For @SANTRALIO_CADDY_CLIENT_IP@
			}
		}
		# Santralio test sağlayıcısının sayfası (yalnızca test modu; gerçek para hareketi yok).
		@payment_test_page {
			method GET POST
			path_regexp ^/api/payments/test-page/pay_[a-z0-9]{20}$
		}
		handle @payment_test_page {
			request_body {
				max_size 4KB
			}
			reverse_proxy 127.0.0.1:8090 {
				header_up X-Forwarded-For @SANTRALIO_CADDY_CLIENT_IP@
			}
		}
		respond 404
	}
}

http://@SANTRALIO_SIP_HOST@ {
	handle /.well-known/acme-challenge/* {
		root * /var/lib/santralio-acme
		file_server
	}
	handle {
		respond 404
	}
}
