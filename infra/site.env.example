# Santralio sunucu ayarları: /etc/santralio/site.env
# install-all.sh ilk kurulumda komut satırı seçeneklerinden oluşturur; sonra elle düzenlenebilir.

# Ana alan adı. Adresler: panel.<alan>, crm.<alan>, agent.<alan> (web, proxy'li olabilir)
SANTRALIO_BASE_DOMAIN=ornek.com
# Santralin SIP adresi; DNS'te proxy'siz olmalı ve sunucunun genel IP'sini göstermeli.
SANTRALIO_SIP_HOST=sip.ornek.com
# Sunucunun genel IPv4 adresi (arayüzde doğrudan bulunmalı; NAT arkası desteklenmez).
SANTRALIO_PUBLIC_IP=203.0.113.10
# Panel adresleri Cloudflare proxy'si (turuncu bulut) arkasında mı: yes | no
SANTRALIO_CLOUDFLARE=yes
# Let's Encrypt bildirimleri için e-posta (boş bırakılabilir).
SANTRALIO_ACME_EMAIL=
# Yapay zekâ karşılaması: Azure Speech bölgesi (anahtar: sudo infra/set-secret.sh azure-speech).
# AB içinde: westeurope (Hollanda), germanywestcentral (Almanya).
SANTRALIO_AZURE_SPEECH_REGION=westeurope
# Vozyy lisans entegrasyonu. Gizli anahtarlar burada değil: sudo infra/set-secret.sh vozyy-signing | vozyy-inbound
# Vozyy uçları bu adresin altında: <VOZYY_API_BASE>/api/santralio/... (site ve kontrol servisi aynı ayarı kullanır).
# 2026-11-05 itibarıyla uçlar ağ geçidinde /license altında: https://api.vozyy.com/license
VOZYY_API_BASE=https://api.vozyy.com/license
# Kayıt formunun Cloudflare Turnstile site anahtarı (açık anahtar; gizli değil).
TURNSTILE_SITE_KEY=
